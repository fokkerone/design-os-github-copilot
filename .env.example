# Auth for Design OS Docker agents — set ONE of these.
# Cloud / shared use: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Local, personal use only: token from `claude setup-token` (Pro/Max subscription)
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: model override for all agents (otherwise the agent definition / SDK default is used)
DESIGNOS_AGENT_MODEL=
