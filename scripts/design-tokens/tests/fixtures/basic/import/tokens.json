{
  "theme": {
    "primary": { "$value": "#0ba4a1", "$type": "color" },
    "primary-dark": { "$value": "#3dd9c3", "$type": "color" },
    "primary-foreground": { "$value": "#fcfcfc", "$type": "color" },
    "primary-foreground-dark": { "$value": "#1b1d22", "$type": "color" },
    "background-dark": { "$value": "#1b1d22", "$type": "color" },
    "border": { "$value": "#c5c5bd", "$type": "color" },
    "border-dark": { "$value": "#ffffff1a", "$type": "color" }
  },
  "custom": {
    "backdrop-overlay": { "$value": "#3c3a4099", "$type": "color" }
  },
  "colors": {
    "base": {
      "white": { "$value": "#ffffff", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    },
    "fuschia": {
      "500": { "$value": "#d946ef", "$type": "color" },
      "50": { "$value": "#fdf4ff", "$type": "color" }
    },
    "zinc": {
      "500": { "$value": "#71717a", "$type": "color" }
    }
  },
  "opacity": {
    "primary": {
      "10": { "$value": "#1717171a", "$type": "color" }
    },
    "opacity-50": { "$value": 50, "$type": "number" }
  },
  "spacing": {
    "1": { "$value": 4, "$type": "number" },
    "2": { "$value": 8, "$type": "number" },
    "px": { "$value": 1, "$type": "number" },
    "0,5": { "$value": 2, "$type": "number" },
    "18": { "$value": 70, "$type": "number" }
  },
  "height": {
    "h-1": { "$value": 4, "$type": "number" }
  },
  "border radius": {
    "sm": { "$value": 6, "$type": "number" },
    "rounded": { "$value": 9999, "$type": "number" }
  },
  "typography": {
    "font-size": {
      "xs": { "$value": 12, "$type": "number" },
      "5xl": { "$value": 48, "$type": "number" }
    },
    "line-height": {
      "xs": { "$value": 16, "$type": "number" },
      "5xl": { "$value": 0, "$type": "number" }
    },
    "font-weight": {
      "semi bold": { "$value": 600, "$type": "number" },
      "regular": { "$value": 400, "$type": "number" }
    }
  },
  "font family": {
    "font-sans": { "$value": "Inter", "$type": "number" }
  },
  "shadow": {
    "sm": {
      "offset-x": { "$value": 0, "$type": "number" }
    }
  },
  "Light": {
    "box-shadow": {
      "default": {
        "sm": {
          "$value": [
            { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px", "color": "#0000001a" },
            { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#0000001a" }
          ],
          "$type": "shadow"
        }
      }
    }
  },
  "Dark": {
    "box-shadow": {
      "default": {
        "sm": {
          "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#00000066" },
          "$type": "shadow"
        }
      }
    }
  },
  "shadow ring": {
    "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px", "color": "#a1a1aa80" },
    "$type": "shadow"
  },
  "breakpoints": {
    "md": { "$value": 768, "$type": "number" }
  },
  "block-width": { "$value": 1440, "$type": "number" },
  "button-size": { "$value": "lg", "$type": "number" },
  "Number": { "$value": 0, "$type": "number" }
}
